			<Events>
				<Event>
					<Id>1782574154458</Id>
					<Name><![CDATA[DailyUpdate]]></Name>
					<X>470</X><Y>-40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_DAY]]></Unit>
						</Rate>
						<Id>1782574154456</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1782633600000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[DAY]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if(orderPending && time() >= orderArrivalDay)
{
    inventory += amountOrdered;

    amountOrdered = 0;

    orderPending = false;

    orderArrivalDay = -1;
}
if(inventory < s && !orderPending)
{
    amountOrdered = S - inventory;

    int leadTime =
            uniform_discr(
                leadTimeMin,
                leadTimeMax
            );

    orderArrivalDay =
            time() + leadTime;

    orderPending = true;

    numOrders++;
    totalOrderCost +=
        costoFijoOrden
        +
        costoIncrementalOrden
        *
        amountOrdered;

    totalUnitsOrdered += amountOrdered;
}
int clientesHoy =
        poisson(lambdaArribo);
        
for(int i=0; i<clientesHoy; i++)
{
    int demandaCliente =
            uniform_discr(
                demandaMin,
                demandaMax
            );

    inventory -= demandaCliente;
}
if(inventory > 0)
{
    totalHoldingCost +=
            inventory *
            costoMantenimientoUnidad;
}
if(inventory < 0)
{
    totalShortageCost +=
            (-inventory) *
            costoFaltanteUnidad;
}
totalCost =
    totalOrderCost
    +
    totalHoldingCost
    +
    totalShortageCost;]]></Action>
				</Event>
			</Events>
